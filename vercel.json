{
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/discord", "permanent": false }
  ],
  "rewrites": [
    { "source": "/discord", "destination": "/index.html" },
    { "source": "/embed", "destination": "/embed.html" },
    { "source": "/apply", "destination": "/index.html" },
    { "source": "/apply-2", "destination": "/index.html" },
    { "source": "/booked", "destination": "/index.html" },
    { "source": "/not-qualified", "destination": "/index.html" },
    { "source": "/redesign/discord", "destination": "/redesign/discord/index.html" },
    { "source": "/redesign/apply", "destination": "/redesign/apply/index.html" },
    { "source": "/redesign/apply-2", "destination": "/redesign/apply-2/index.html" },
    { "source": "/redesign/booked", "destination": "/redesign/booked/index.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/go/:slug", "destination": "/api/go?slug=:slug" }
  ],
  "headers": [
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/admin.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
